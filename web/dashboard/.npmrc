# EDR-GUI-02 D9: no install scripts run, exact versions only, Node 22 enforced.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
audit=false
# npm 10 (Node 22's bundled npm) crashes building the tree for vitest's optional peers
# ("Cannot read properties of null (reading 'edgesOut')"); npm 11 does not. Every peer this
# app needs is listed explicitly in package.json, so legacy peer resolution changes nothing.
legacy-peer-deps=true
