# Themis Phase-3 greenfield node — example environment configuration (CONVENTIONS.md R2).
#
# Every deployable node (evidence / registry / knowledge / governance / communication /
# intelligence) reads its configuration from the environment. Every option is documented
# here inline — there is no separate config reference that can drift. Copy this file, fill in
# the values for the node you are running, and export them (or load with your process
# manager). Secrets are referenced by name, never inlined.

# ─────────────────────────────────────────────────────────────────────────────
# Shared — observability (R1). Read identically by every node from the shared
# internal/platform/observability package. Console logging is always on; OpenTelemetry log AND
# trace export are enabled only when THEMIS_OTLP_ENDPOINT is set. Metrics are the exception —
# they are always registered and SCRAPED from /metrics, never pushed, so a node with no
# collector still keeps usable counters.
# ─────────────────────────────────────────────────────────────────────────────

# Minimum log severity. One of: debug | info | warn | error. Default: info.
THEMIS_LOG_LEVEL=info

# Console log encoding. One of: json (machine-readable, prod) | console (human-readable, dev).
# Default: json.
THEMIS_LOG_FORMAT=json

# OTLP/HTTP collector endpoint, host:port (e.g. otel-collector:4318). Drives LOGS AND TRACES —
# one collector, one knob, because two knobs for one collector is a configuration people get wrong
# in exactly one direction. When empty, both exports are OFF: only the console channel is active
# and the global tracer is a no-op (nothing external needed to run).
#
# METRICS do NOT use this. They are exposed for a Prometheus SCRAPE, which needs no egress
# configured at all — a trace has no pull model, a counter does. That asymmetry is the whole
# telemetry-egress decision (2026-08-07): one exporter dependency instead of two, and metrics keep
# working on a node with no collector.
#
# Default: "" (console-only). THEMIS_OTLP_LOGS_ENDPOINT is still honoured as the former name.
THEMIS_OTLP_ENDPOINT=

# Send to the OTLP endpoint over http instead of https ("1" to enable) — for local collectors.
# Default: 0 (https).
THEMIS_OTLP_INSECURE=0

# ─────────────────────────────────────────────────────────────────────────────
# Shared — datastore. Required by every node that persists.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL DSN. REQUIRED. Provide via your secret store, not a committed file.
THEMIS_DATABASE_DSN=postgres://themis:CHANGEME@localhost:5432/themis?sslmode=disable

# Migrations directory. Every node reads a <NODE>_MIGRATIONS path override; all default to the
# in-repo directory shown, which is why the runbook starts the nodes FROM THE REPO ROOT. Set these
# when you run the binaries from elsewhere (a systemd unit with a different WorkingDirectory, a
# container that ships the SQL at another path) — a wrong path fails the migration at startup, which
# is the correct behaviour but looks like a database problem.
# THEMIS_REGISTRY_MIGRATIONS=internal/registry/adapters/store/migrations
# THEMIS_EVIDENCE_MIGRATIONS=internal/evidence/adapters/store/migrations
# THEMIS_KNOWLEDGE_MIGRATIONS=internal/knowledge/adapters/store/migrations
# THEMIS_GOVERNANCE_MIGRATIONS=internal/governance/adapters/store/migrations
# THEMIS_COMMUNICATION_MIGRATIONS=internal/communication/adapters/store/migrations
# (THEMIS_INTELLIGENCE_MIGRATIONS is in the Intelligence block below; THEMIS_BUS_MIGRATIONS and
#  THEMIS_AUTH_MIGRATIONS are in the bus and auth blocks.)

# ─────────────────────────────────────────────────────────────────────────────
# Shared — the event bus (M5, EDR-EVENTBUS-01). THE cross-context switch.
# ─────────────────────────────────────────────────────────────────────────────

# DSN of the dedicated `bus` database holding the single event_log. **Set it on every node** and the
# outbox relay publishes into it while each reader drains it, so events actually cross contexts.
# Leave it EMPTY and you get a log-only publisher with disabled readers — each context still works
# on its own, and nothing propagates. That second mode is legitimate for single-context dev, but it
# is indistinguishable from a broken pipeline unless you know you chose it. Default: "" (off).
THEMIS_BUS_DATABASE_DSN=

# "1" applies the bus migrations (the event_log table) to THEMIS_BUS_DATABASE_DSN at startup.
# Dev convenience — one node setting it is enough, the migration is idempotent. Default: 0.
THEMIS_BUS_MIGRATE=0
# THEMIS_BUS_MIGRATIONS=internal/platform/eventbus/migrations   # migrations dir (default shown).

# ─────────────────────────────────────────────────────────────────────────────
# Shared — inbound edge auth (F1, EDR-SECURITY-01). Read by every node that serves /api/v1.
# Guards EXTERNAL callers only; service-to-service read clients send no key (inbound-edge only).
# ─────────────────────────────────────────────────────────────────────────────

# DSN of the shared `auth` database (the api_keys store). When SET, this node requires a valid
# X-API-Key on /api/v1 (the node logs "AUTH ENABLED"); when EMPTY, auth is off (dev — logs
# "AUTH DISABLED"). Mint keys with `cmd/authadmin create-key --name <n> --scopes <scope,...>`
# (THEMIS_AUTH_MIGRATE=1 creates the table on first use; the token prints once). Default: "" (off).
# The scope vocabulary is CLOSED (EDR-DELIVERY-01 N-M0) — anything else is refused at mint time AND
# grants no write when read, so a legacy key carrying an unknown scope loses write capability
# (audit: SELECT id, name, scopes FROM api_keys WHERE revoked_at IS NULL;):
#   admin              read + write, every product
#   read               read-only
#   product:<id>       writes confined to that product's resources; on Governance the route
#                      resolves Finding -> release -> product, so THEMIS_REGISTRY_URL must be set
#                      and reachable or the write is REFUSED (fail-closed; admin is unaffected)
#   delivery:callback  an outward delivery target calling back; NO Governance write, ever
THEMIS_AUTH_DATABASE_DSN=

# Production guard: "1" makes the node REFUSE TO START when THEMIS_AUTH_DATABASE_DSN is empty, so
# a node can never boot open by mistake. Leave 0 for single-box dev. Default: 0.
THEMIS_AUTH_REQUIRED=0

# THEMIS_AUTH_MIGRATE=0                    # "1" creates the api_keys table on startup (also honored by cmd/authadmin).
# THEMIS_AUTH_MIGRATIONS=internal/platform/auth/migrations   # migrations dir (default shown).

# ─────────────────────────────────────────────────────────────────────────────
# Per-node options (set the block for the node you are running). Each node's config struct
# in cmd/<node>/main.go documents these inline as well.
# ─────────────────────────────────────────────────────────────────────────────

# Evidence (cmd/evidence)
THEMIS_EVIDENCE_ADDR=:8081                 # HTTP listen address. Default :8081.
THEMIS_EVIDENCE_MIGRATE=0                  # "1" to apply Evidence migrations on startup.
THEMIS_EVIDENCE_DEV_PURGE=0                # "1" to expose DELETE /dev/evidence (dev only).
# THEMIS_EVIDENCE_KNOWN_RELEASES=          # dev only: comma-separated release ids for the stub SubjectRef; empty = registry-backed.

# Registry (cmd/registry)
THEMIS_REGISTRY_ADDR=:8082                 # HTTP listen address. Default :8082.
THEMIS_REGISTRY_MIGRATE=0                  # "1" to apply Registry migrations on startup.
THEMIS_REGISTRY_DEV_PURGE=0                # "1" to expose DELETE /dev/registry (dev only).

# Knowledge (cmd/knowledge)
THEMIS_KNOWLEDGE_ADDR=:8085                # HTTP listen address. Default :8085 — matches every other node's THEMIS_KNOWLEDGE_URL default.
THEMIS_KNOWLEDGE_MIGRATE=0                 # "1" to apply Knowledge migrations on startup.
THEMIS_KNOWLEDGE_DEV_PURGE=0               # "1" to expose DELETE /dev/knowledge (dev only).
THEMIS_EVIDENCE_URL=http://localhost:8081  # Evidence read-API base URL — the inventory source for correlation.
THEMIS_OSV_URL=https://api.osv.dev         # OSV query base URL — lazy discovery (language + distro ecosystems).
# Optional scheduled NVD enrichment (D5/D5a): fetches each CARDED CVE by id and folds authoritative
# CVSS/severity onto its card. Per-CVE, not a modified-since window walk — cost is proportional to the
# estate rather than to NVD's churn. (Measured 2026-08-07: the old walk fetched 3,207 records to apply 18,
# at ~84s per day of window; a 120-day cold start was ~2.8 hours. See NVD-WATCH-1 / EDR-KNOWLEDGE-01 D5a.)
THEMIS_NVD_ENABLED=0                       # "1" to enable enrichment. Default off (no external NVD calls).
# THEMIS_NVD_URL=                          # NVD 2.0 CVE API base URL. Empty = services.nvd.nist.gov.
# THEMIS_NVD_API_KEY=                      # NVD API key (higher rate limit; optional but recommended — requests are paced from it).
THEMIS_NVD_POLL_INTERVAL=6h                # Go duration between enrichment sweeps. Default 6h.
THEMIS_REATTRIBUTE_INTERVAL=6h             # Go duration between RE-ATTRIBUTION sweeps (KN-FIX-2). Only OSV and Red Hat attribute a fix to a package (NVD keys on CPE, scanners report bare versions), and OSV is queried during CORRELATION — i.e. on upload. So a card whose releases are never re-uploaded keeps a flat, unattributed fix list forever, and "upload it again" is not a workaround: Evidence is content-addressed, so identical bytes dedup. This sweep re-asks the discovery feeds about components already in the estate. Always on — it needs no feed the node is not already using — bounded per run, and self-terminating: once everything is attributed it finds nothing and writes nothing.
# KN-RECOR-1 re-discovery sweep — DEFAULT ON. Discovery otherwise runs only at upload time, so a
# CVE published AFTER a release's last upload is invisible until the next one, while every
# dashboard stays green. This sweep re-runs the full discovery fan-out (OSV + NVD when enabled)
# for the stalest correlated releases, so new CVEs reach months-old inventory with nobody
# uploading anything. Idempotent end to end; feed load per tick is limit x components-per-release.
# THEMIS_REDISCOVERY_ENABLED=1               # "0" disables (and the node logs a warning saying what goes blind).
# THEMIS_REDISCOVERY_INTERVAL=1h             # loop tick.
# THEMIS_REDISCOVERY_STALE_AFTER=24h         # how old a release's last discovery may grow.
# THEMIS_REDISCOVERY_LIMIT=3                 # releases re-discovered per tick; a large estate drains across ticks.

# Occurrence-verdict ownership bridge (EDR-VERDICT-01 D3/D4). A language-package component that is
# really the on-disk shadow of a distro rpm (site-packages installed by python3-setuptools) can be
# CLEARED by the rpm's vendor fix through two evidence grades: an explicit SBOM ownership edge
# (observed — Syft SPDX emits them) or a same-inventory name+exact-version match (inferred — a
# labeled guess Themis works out itself; its one wrong-clear case is a hand-installed copy of the
# EXACT distro version). Every clearance is recorded with its grade and premise, never deleted.
# THEMIS_VERDICT_INFERRED_BRIDGE=0            # "0" = strict mode: only explicit ownership evidence may clear. Default on.
# The re-verdict (EDR-VERDICT-01 D6): existing match rows are re-judged when their card learns
# something — immediately after any feed sweep that folded (the fix-folding loops nudge it), plus a
# self-targeting interval sweep that drains history (every pre-feature row) and heals downtime.
# Two stamps drive staleness: the card version (new DATA) and a judgement-logic generation (new
# CODE, KN-VERDICT-2). Without the second, deploying a changed verdict rule re-judged nothing --
# every row read as current and the sweep honestly reported rejudged:0. Neither is configurable;
# both are logged on every sweep.
# THEMIS_REVERDICT_INTERVAL=12h               # catch-up cadence; the nudge path is the real latency for fresh news.
# THEMIS_REVERDICT_BATCH=200                  # stale rows re-judged per sweep; a large estate drains across nudges/ticks.
# The re-classification sweep (EDR-CORRELATION-01 D3/D4): a component's claim class -- carrier,
# scope or unknown -- is decided from its card's carrier products, and that decision goes stale two
# ways. New carrier evidence is re-announced INLINE by the fold that brings it, so this sweep exists
# for the two things no fold signals: history, and a change to the classification RULES (which
# advances no card version and folds nothing, so without the generation stamp a corrected rule
# applies only to matches that do not exist yet).
# THEMIS_RECLASSIFY_INTERVAL=6h               # catch-up cadence; the inline trigger is the latency for fresh carrier news.
# THEMIS_RECLASSIFY_BATCH=100                 # stale CARDS re-announced per sweep; while a batch comes back full the loop sweeps again, so a rule change drains in minutes rather than days.
THEMIS_NVD_STALE_AFTER=168h                # How long a card's NVD facts stay fresh before the sweep revisits it (Go duration, default 168h = 7 days). Revisiting is what catches REVISED scores and CVEs WITHDRAWN upstream (NVD `vulnStatus: "Rejected"` retires the card). An enrich-once sweep is correct on the day it runs and quietly stale months later. Lower = fresher and more requests; a settled estate at 168h costs ~52 fetches per card per year.
THEMIS_NVD_BACKFILL_LIMIT=200              # Carded CVEs enriched per sweep (one small request each). Bounds a sweep to a predictable duration; a large estate drains over successive sweeps. Cards already carrying an NVD Proposal are skipped, so a settled estate costs one query and no fetches.
# Optional NVD correlation discovery (A2): a per-component, CPE-product-gated keyword query so a CVE only
# NVD's CPE data covers still yields a finding. Distinct from the watch above (this runs at correlation time).
THEMIS_NVD_DISCOVERY=0                      # "1" to enable. Default off. One NVD call per component — set THEMIS_NVD_API_KEY (NVD throttles hard without one).
# Optional scheduled exploit-signal enrichment (D5): folds EPSS/KEV/public-exploit onto already-carded CVEs.
THEMIS_EPSSKEV_ENABLED=0                   # "1" to enable the sweep. Default off (no external EPSS/KEV/ExploitDB calls).
# THEMIS_EPSS_URL=                         # FIRST.org EPSS gzip-CSV. Empty a source to skip it. Default = the current-scores feed.
# THEMIS_KEV_URL=                          # CISA KEV JSON catalog. Default = cisa.gov KEV feed.
# THEMIS_EXPLOITDB_URL=                     # ExploitDB files_exploits.csv. Default = the gitlab mirror.
THEMIS_EPSSKEV_POLL_INTERVAL=24h           # Go duration between enrichment sweeps. Default 24h.
# Optional Red Hat vendor feed (parity B3, EDR-VEX-01): per-CVE vendor severity + not_affected applicability
# folded onto already-carded CVEs — covers RHEL and its 1:1 rebuilds (Rocky, Alma). Relevance-bounded (D5).
THEMIS_REDHAT_ENABLED=0                     # "1" to enable the scheduled Red Hat sweep. Default off (no external Red Hat calls).
# THEMIS_REDHAT_URL=                        # Red Hat Security Data API base URL. Empty = the public Hydra default (access.redhat.com); no API key needed.
# THEMIS_REDHAT_CHANGES_URL=                # Per-CVE VEX changes.csv the modified-since gate reads (EDR-VEX-01 D10). Empty = Red Hat's public VEX change log. The gate fails open to a full sweep, so it needs no switch of its own.
THEMIS_REDHAT_POLL_INTERVAL=12h            # Go duration between Red Hat sweeps. Default 12h.
# Optional Alpine secdb feed (GUI-2, EDR-VEX-01 D7): fixed apk version bounds folded onto already-carded CVEs —
# the one distro with correlation but no vendor fix data otherwise. The secdb is not per-CVE addressable, so the
# sweep fetches whole (small) branch DBs and discards everything uncarded in memory (D5 — enrichment, never a mirror).
THEMIS_ALPINE_ENABLED=0                     # "1" to enable the scheduled Alpine secdb sweep. Default off (no external Alpine calls).
# THEMIS_ALPINE_URL=                        # Alpine secdb base URL. Empty = the public default (secdb.alpinelinux.org); no API key needed.
# THEMIS_ALPINE_BRANCHES=v3.20,v3.21        # Comma-separated secdb branches to sweep. Default over-covers (v3.18..v3.22); an absent branch 404s harmlessly. Set to the branches your estate actually ships.
THEMIS_ALPINE_POLL_INTERVAL=12h            # Go duration between Alpine sweeps. Default 12h.
# Optional Rocky RXSA errata feed (GUI-5, EDR-VEX-01 D11): fixed NEVRAs for Rocky-exclusive/SIG packages that exist
# in no Red Hat data — the one Rocky gap the clone-covering Red Hat feed cannot reach. The tiny RXSA advisory set is
# walked whole and everything uncarded discarded in memory (D5); RLSA clones are excluded (they ride the Red Hat feed).
THEMIS_ROCKY_ENABLED=0                      # "1" to enable the scheduled Rocky RXSA sweep. Default off (no external Rocky calls).
# THEMIS_ROCKY_URL=                         # Rocky errata (Apollo) base URL. Empty = the public default (errata.rockylinux.org); no API key needed.
THEMIS_ROCKY_POLL_INTERVAL=12h             # Go duration between RXSA sweeps. Default 12h.
# Optional generic CSAF-VEX vendor feed (parity B4, EDR-VEX-01): per-CVE not_affected applicability folded onto
# already-carded CVEs from any CSAF trusted provider. Relevance-bounded (D5) — fetches only carded CVEs, per-CVE.
THEMIS_VEXFEED_ENABLED=0                    # "1" to enable the scheduled CSAF-VEX sweep. Default off.
# THEMIS_VEXFEED_URLS=                      # Comma-separated CSAF-VEX directory base URLs (per-CVE files at <base>/<year>/cve-<id>.json). Empty = no feeds.
THEMIS_VEXFEED_POLL_INTERVAL=12h           # Go duration between CSAF-VEX sweeps. Default 12h.

# Governance (cmd/governance)
THEMIS_GOVERNANCE_ADDR=:8083               # HTTP listen address. Default :8083.
THEMIS_GOVERNANCE_MIGRATE=0                # "1" to apply Governance migrations on startup.
# THEMIS_API_KEY=                           # Sent as X-API-Key on Governance's READS (Registry, Knowledge, Evidence).
#                                           # REQUIRED where those nodes run with auth on: an unauthenticated read
#                                           # answers 401, the release-evaluation worker (N-M2b) then never publishes,
#                                           # the blast-radius multiplier falls back to 1.0 and the assessment
#                                           # projection loses its Knowledge view. A READ-scoped key is enough. Never logged.
THEMIS_GOVERNANCE_DEV_PURGE=0              # "1" to expose DELETE /dev/governance (dev only).
THEMIS_REGISTRY_URL=http://localhost:8082  # Registry read-API base URL — the estate blast-radius source for the Finding priority multiplier (C2). Default :8082 (works on a single box); empty ⇒ multiplier defaults to 1.0×.
THEMIS_KNOWLEDGE_URL=http://localhost:8085 # Knowledge read-API base URL — the CVE-enrichment half of the FindingAssessment Domain Projection (EDR-TRUST-01 T10, GET /findings/{id}/assessment). Default :8085; empty ⇒ the projection carries the Finding alone (fail-safe: a Knowledge outage degrades the view, never the request).
THEMIS_EVIDENCE_URL=http://localhost:8081  # Evidence read-API base URL — the evidence-presence guard under the release-comparison read (EDR-GOVERNANCE-01 D16, GET /releases/{id}/compare/{candidate}). Default :8081; empty ⇒ the compare endpoint refuses (fail-CLOSED: "fixed" is absence proven by new evidence, and a compare that cannot verify evidence would over-claim it). Every other Governance read is unaffected.
THEMIS_GOVERNANCE_AUTOACCEPT=observed_not_affected  # Governance-owned auto-accept policy (EDR-GOVERNANCE-01 D15). `observed_not_affected` (default) ships ONE rule: auto-accept a proposal only when it is open AND system-raised AND its stance is `not_affected` AND its evidence class is `observed` — i.e. re-derivable by anyone (the version-range verdict, an upstream CVE withdrawal). `off` disables auto-accept entirely, so every suppression waits for a human. Note what is NOT auto-accepted under either setting: vendor VEX is `asserted` (a vendor's word about their own build), and EDR-VEX-01 keeps it gathered-not-obeyed — it raises a proposal for a human. AI proposals are `inferred` and are barred constitutionally (EDR-TRUST-01 T4) before policy is even consulted.
THEMIS_BLAST_RADIUS_CAP=10                 # Unique-customer count at which the blast multiplier saturates to 2.0× (C2). Default 10 (legacy `intelligence.blast_radius_cap` parity). A value < 2 is treated as the default; the +0.1/customer slope means values above ~11 already saturate.
THEMIS_EPSS_DRIFT_THRESHOLD=0.20            # EPSS rise that RE-SURFACES a suppressed Finding (GOV-14b / EDR-GOVERNANCE-01 D14). ABSOLUTE, not relative: 0.02 -> 0.25 is a fringe CVE becoming a likely one, while 0.60 -> 0.75 is the same story told louder — and a relative threshold fires constantly in the noise near zero, where EPSS is least stable and a re-surfaced Finding least likely to be real. This is the SAFETY NET under residual_priority: zeroing a not_affected/accepted_risk Finding removes it from the queue, which is only safe because something brings it back when the premise moves. An out-of-range value falls back to the default; a misconfigured knob must not silently disable it. The other two triggers are not tunable: a CVE entering KEV and a newly public exploit always re-surface, as does a passed `review_by` date on the decision.
THEMIS_MITIGATED_WEIGHT=0.5                # Stance weight for `mitigated` in the posture's residual_priority (EDR-GOVERNANCE-01 D14). Must be in (0,1]; anything else falls back to 0.5. The other weights are STRUCTURAL and deliberately not configurable: not_affected/accepted_risk 0 (terminal — the risk is removed or knowingly owned), deferred 0.9, and affected/under_investigation/no-position 1.0. Note residual_priority is what you SORT a triage queue by; effective_priority stays the intrinsic severity so a suppression never erases how bad the issue actually is.

# Communication (cmd/communication)
THEMIS_COMMUNICATION_ADDR=:8084            # HTTP listen address. Default :8084.
THEMIS_GOVERNANCE_URL=http://localhost:8083 # Governance read-API base URL (for GetPosition; the release rollup also reads the posture here).
THEMIS_REGISTRY_URL=http://localhost:8082   # Registry read-API base URL — the release rollup's name chain (EDR-COMMUNICATION-01 D13.4). FAIL-CLOSED: if the chain cannot name the product, the rollup refuses to publish (422) rather than shipping a customer document whose product line is a UUID.
# THEMIS_API_KEY=                           # Sent as X-API-Key on the two READS above (Governance, Registry). Same
#                                           # variable name the Dashboard proxy and the Intelligence node use.
#                                           # REQUIRED on an estate where those nodes run with THEMIS_AUTH_REQUIRED=1
#                                           # (or simply with THEMIS_AUTH_DATABASE_DSN set): an unauthenticated read
#                                           # answers 401, and since N-M1b the remediation-ticket payload is rendered
#                                           # FROM that read inside the inbox transaction — so a 401 means no Jira
#                                           # intent is recorded and the Governance event retries forever. A release
#                                           # rollup likewise refuses, because the name chain fails closed. Both
#                                           # errors now name this variable instead of printing a bare status.
#                                           # A READ-SCOPED key is enough and is what to use — this node writes to
#                                           # neither Governance nor Registry:
#                                           #   authadmin create-key --name communication-read --scopes read
#                                           # Unset = the reads are unauthenticated (auth-off dev), as before. The key
#                                           # is never logged; startup logs only whether one is set.
#                                           # NOTE the variable is shared by name, not by value: the Intelligence node
#                                           # uses THEMIS_API_KEY for its WRITE key and the Dashboard proxy for an admin
#                                           # key. Give each node its OWN env file (deploy/systemd/install-systemd.sh
#                                           # does), or one file hands this node a write-capable credential it has no
#                                           # use for.
THEMIS_COMMUNICATION_MIGRATE=0             # "1" to apply Communication migrations on startup.
THEMIS_COMMUNICATION_DEV_PURGE=0           # "1" to expose DELETE /dev/communication (dev only).
# Outward delivery (N-M1a/N-M1b, EDR-DELIVERY-01 Revision 4). An outward action is a credentialed act that LEAVES
# the estate, so the whole path is OPT-IN. Off (the default) means BOTH halves are off: the Governance-stream reader
# records no delivery intents and no sender runs — a node that will not send must not accumulate a queue nobody
# drains. The switch below turns on the MECHANISM with FAKE senders (log-only, no network); the real Jira and mail
# senders are two further, independent switches further down, so "delivery is running" never implies "something
# left the estate".
THEMIS_COMMUNICATION_DELIVERY_ENABLED=0    # "1" to record delivery intents and run the senders. Default off.
THEMIS_COMMUNICATION_DELIVERY_WORKERS=2    # Concurrent sends per pass. Default 2. One fetcher claims the batch and feeds these, so two goroutines never claim the same intent.
THEMIS_COMMUNICATION_DELIVERY_BATCH=50     # Due intents claimed per pass. Default 50.
THEMIS_COMMUNICATION_DELIVERY_MAX_ATTEMPTS=3  # Attempts before an intent dead-letters. Default 3. A dead letter is TERMINAL until a person retries it (`deliveryctl retry`) — it changes no Finding and no Position: outward failure is never a security-truth change (RC-7).
THEMIS_COMMUNICATION_DELIVERY_BACKOFF_INITIAL=1s  # Delay after the first failed attempt; doubles per attempt. Default 1s.
THEMIS_COMMUNICATION_DELIVERY_BACKOFF_MAX=30s     # Cap on the doubling. Default 30s. A value below the initial delay is raised to it rather than inverting the schedule.
THEMIS_COMMUNICATION_DELIVERY_INTERVAL=5s  # Worker loop cadence. Default 5s.
THEMIS_COMMUNICATION_DEADLETTER_AUDIENCE=operations  # GOVERNED audience name told that a delivery gave up. Default "operations". It is a NAME, resolved to real recipients by the sender — an intent never carries an address or a credential.
# Any out-of-range value above falls back to its default: a misconfigured knob must not silently disable the
# mechanism it configures. Operator surface: `go run ./cmd/deliveryctl list-deadletters|retry|cancel` (reads
# THEMIS_DATABASE_DSN; there is NO HTTP API for this).
#
# ── The REAL senders (N-M1b) ──────────────────────────────────────────────────────────────────────────────────
# Two independent switches, both OFF by default and both subordinate to THEMIS_COMMUNICATION_DELIVERY_ENABLED
# above. Enabling one with an incomplete configuration does NOT send: the node keeps the fake sender, logs the
# missing variable names at ERROR, and keeps draining — but the log never lets "sending to Jira" and "logging
# instead" look alike. SECRETS (the Jira API token, the SMTP password) are read from the environment ONLY; no
# configuration file in this repository holds one, and none may. Put them in /etc/themis/<svc>.env with mode 0600
# or in your secret store — never in a unit file, a shell history or a commit.
#
# Jira: ONE TICKET PER RELEASE (RC-2). The sender looks for the Release's ticket in this order — (1) Themis's OWN
# RECORD, the `jira_issue_key` on an earlier delivered intent for that Release, (2) a JQL search for the exact label
# `themis-release-<release-uuid>`, as a FALLBACK — and REPLACES the content of whatever it finds; it creates only
# when neither answers. The body carries severity COUNTS for Critical/High/Medium/Low and lists CVE ids for Critical
# and High ONLY. The key is recorded on the intent's delivery result, so the ticket an obligation landed on stays
# answerable from Themis alone.
#
# The create carries NO LABELS, because a project can forbid them on its create screen (Jira answers "Field
# 'labels' cannot be set") and would refuse the whole create over that one field. They are added by a follow-up
# edit, best effort: if that edit fails the ticket still stands, the key is still recorded, and the next update
# retries the labels. That is also why Themis's own record is consulted first — a ticket whose label never landed
# cannot be found by searching for the label.
# Work on one Release is serialized inside the node, so the dozens of intents one Release produces cannot open
# dozens of tickets. Across TWO Communication nodes draining one database that serialization does not hold; the
# record lookup makes a duplicate unlikely rather than impossible.
# The credential needs CREATE and EDIT on the project; BROWSE/SEARCH only matters for the fallback.
#
# TWO FLAVOURS. Jira Cloud and Jira Data Center / Server differ in exactly two knobs, and the DEFAULTS are Cloud's,
# so a Cloud deployment sets neither. Pick a pair and set both — they are not independent:
#   Cloud:        THEMIS_COMMUNICATION_JIRA_AUTH=basic   + THEMIS_COMMUNICATION_JIRA_API_VERSION=3  (the defaults)
#   Data Center:  THEMIS_COMMUNICATION_JIRA_AUTH=bearer  + THEMIS_COMMUNICATION_JIRA_API_VERSION=2
# Everything else is identical, including the label search that realizes one-ticket-per-Release. A mismatched pair
# fails in a way that does not look like configuration: v3 against Data Center is "Jira rejects our ticket" (400 on
# every attempt, because v3 wants a rich-text document where v2 wants a plain string), and basic auth with a Data
# Center token is "the token is wrong" (401). An unsupported value for either knob is REFUSED at startup.
THEMIS_COMMUNICATION_JIRA_ENABLED=0        # "1" to send real Jira tickets. Default off (the fake sender logs instead).
# THEMIS_COMMUNICATION_JIRA_BASE_URL=      # Where Jira is mounted. Cloud: https://acme.atlassian.net
#                                          # Data Center is usually behind a PATH: https://jira.acme.example/jira —
#                                          # the path is preserved and every REST call is appended to it. A trailing
#                                          # "/" is trimmed. Give the SCHEME: a bare host:port is refused.
#                                          # MUST be https:// — the credential rides EVERY request (a Basic password
#                                          # or a Bearer token), so plain http would put it on the wire in base64,
#                                          # which is an encoding and not protection. A clear-text http:// URL is
#                                          # REFUSED at startup and the node keeps the fake sender; http:// is
#                                          # accepted only for a LOOPBACK host (127.0.0.1, ::1, localhost), where
#                                          # the bytes never leave the machine.
# THEMIS_COMMUNICATION_JIRA_PROJECT_KEY=   # Project key tickets live in, e.g. SEC.
# THEMIS_COMMUNICATION_JIRA_AUTH=basic     # How the credential is presented. Default "basic".
#                                          #   basic   Jira CLOUD: account email (…_USER) + API token as HTTP Basic.
#                                          #   bearer  Jira DATA CENTER / Server: a Personal Access Token sent as
#                                          #           `Authorization: Bearer`. …_USER is NOT needed and NOT sent —
#                                          #           a PAT identifies its own owner (Jira → Profile → Personal
#                                          #           Access Tokens).
# THEMIS_COMMUNICATION_JIRA_API_VERSION=3  # Jira REST major version. Default 3.
#                                          #   3  Cloud — the description is sent as a rich-text document (ADF).
#                                          #   2  Data Center / Server — the description is sent as plain text.
# THEMIS_COMMUNICATION_JIRA_USER=          # Jira account email the API token belongs to. Required for AUTH=basic;
#                                          # ignored for AUTH=bearer.
# THEMIS_COMMUNICATION_JIRA_API_TOKEN=     # SECRET. The credential itself: a Cloud API token under AUTH=basic, a
#                                          # Data Center PERSONAL ACCESS TOKEN under AUTH=bearer. Environment only —
#                                          # never a config file, never a log.
# THEMIS_COMMUNICATION_JIRA_ISSUE_TYPE=Task  # Issue type NAME to create. Default "Task" (every project template has
#                                          # one). Ignored when …_ISSUE_TYPE_ID is set.
# THEMIS_COMMUNICATION_JIRA_ISSUE_TYPE_ID= # Issue type ID, e.g. 10501. When set, the issue type is sent BY ID and the
#                                          # name is not sent at all. Use this when the project's types are renamed,
#                                          # localized, or duplicated across schemes — the id is what a Jira admin
#                                          # reads off the create screen that worked by hand.
# THEMIS_COMMUNICATION_JIRA_EXTRA_FIELDS=  # A JSON OBJECT merged into every CREATE's `fields`: the project-specific
#                                          # required fields a Jira screen demands and Themis has no opinion about.
#                                          # Sent verbatim, so use whatever shape the field takes ({"value":"…"} for a
#                                          # single-select, {"id":"…"} if you prefer ids, an array for versions).
#                                          # It can never override project, issuetype, summary, description or labels —
#                                          # those are the ticket's identity and its snapshotted content; a reserved
#                                          # key is IGNORED and the node logs which. INVALID JSON refuses the sender at
#                                          # startup and keeps the fake one, because a field Jira requires must not be
#                                          # discovered one failed create per Release. Create only: the update carries
#                                          # content alone, so Themis never overwrites what a human changed.
# THEMIS_COMMUNICATION_JIRA_TIMEOUT=15s    # Bounds one Jira HTTP call. Default 15s. A timeout is a retry, never a Themis change.
#
# A Jira Data Center node, complete (uncomment and fill):
# THEMIS_COMMUNICATION_JIRA_ENABLED=1
# THEMIS_COMMUNICATION_JIRA_BASE_URL=https://jira.acme.example/jira
# THEMIS_COMMUNICATION_JIRA_PROJECT_KEY=SEC
# THEMIS_COMMUNICATION_JIRA_AUTH=bearer
# THEMIS_COMMUNICATION_JIRA_API_VERSION=2
# THEMIS_COMMUNICATION_JIRA_API_TOKEN=<the Personal Access Token>   # no …_USER under bearer
#
# The ME project (the estate's own, verified against a manual create): Data Center behind /jira, issue type by ID,
# and four required custom fields plus a version. Note the JSON is ONE line — an env file has no line continuation.
# THEMIS_COMMUNICATION_JIRA_ENABLED=1
# THEMIS_COMMUNICATION_JIRA_BASE_URL=https://almsbx.radisys.com/jira
# THEMIS_COMMUNICATION_JIRA_PROJECT_KEY=ME
# THEMIS_COMMUNICATION_JIRA_AUTH=bearer
# THEMIS_COMMUNICATION_JIRA_API_VERSION=2
# THEMIS_COMMUNICATION_JIRA_API_TOKEN=<the Personal Access Token>
# THEMIS_COMMUNICATION_JIRA_ISSUE_TYPE_ID=10501
# THEMIS_COMMUNICATION_JIRA_EXTRA_FIELDS={"customfield_10911":{"value":"Critical"},"customfield_11408":{"value":"Internal"},"customfield_11409":{"value":"Implementation"},"customfield_10804":{"value":"All"},"versions":[{"id":"83572"}]}
#   customfield_10911 Critical · customfield_11408 Internal · customfield_11409 Implementation ·
#   customfield_10804 All · versions id 83572. If a select field refuses {"value":…}, send {"id":"…"} instead —
#   the object is passed through untouched, so the field's own shape is yours to choose.
#
# Mail: plain text, no attachments, one mail per intent id (RC-5). Recipients are resolved HERE from the GOVERNED
# audience name the intent carries — an intent never holds an address — and an audience with no mapping is REFUSED
# rather than redirected to a default: the wrong people reading a security decision is worse than a dead letter an
# operator can see. The audience names come from THEMIS_COMMUNICATION_DEADLETTER_AUDIENCE above and from the
# decision audience (default "security-decisions"); a central governed audience registry is not yet present, so
# this map is the registry.
THEMIS_COMMUNICATION_MAIL_ENABLED=0        # "1" to send real mail. Default off (the fake sender logs instead).
# THEMIS_COMMUNICATION_MAIL_HOST=          # SMTP relay hostname.
# THEMIS_COMMUNICATION_MAIL_PORT=587       # SMTP port. Default 587 (submission).
# THEMIS_COMMUNICATION_MAIL_FROM=          # Envelope + header sender address, e.g. themis@acme.example.
# THEMIS_COMMUNICATION_MAIL_USERNAME=      # SMTP account. Empty = an unauthenticated relay (common in-estate).
# THEMIS_COMMUNICATION_MAIL_PASSWORD=      # SECRET. SMTP password. Environment only. A username WITHOUT STARTTLS is
#                                          # REFUSED at startup for a non-loopback relay — the password would cross the
#                                          # network in the clear, and net/smtp refuses it one layer down anyway.
# THEMIS_COMMUNICATION_MAIL_STARTTLS=1     # Upgrade before authenticating. Default ON. A relay that offers no STARTTLS
#                                          # with this on is a refusal, not a silent downgrade.
# THEMIS_COMMUNICATION_MAIL_TIMEOUT=15s    # Bounds EVERY step of the SMTP conversation, not just the connection: a relay
#                                          # that accepts the connection and then stops answering times out and is retried
#                                          # instead of holding a worker goroutine. Default 15s.
# THEMIS_COMMUNICATION_MAIL_AUDIENCES=     # GOVERNED audience -> recipients. Audiences separated by ";", the name from its
#                                          # recipients by "=", recipients by ",". Required when mail is enabled, e.g.
#                                          # security-decisions=sec@acme.example,lead@acme.example;operations=ops@acme.example
#                                          # An address containing a control character (a pasted newline) is DROPPED, and an
#                                          # audience left with no recipient refuses loudly at send time — a newline in an
#                                          # address injects message headers, so it is never repaired silently. The same
#                                          # character in THEMIS_COMMUNICATION_MAIL_FROM refuses startup.
#
# PAYLOAD SNAPSHOT (D-N-3): a ticket body or a mail body is rendered ONCE, when the intent is recorded, and stored
# with its SHA-256. Every retry re-sends those exact bytes, so a retry is a delivery retry and never a second
# communication. Rendering a ticket reads the Release posture from THEMIS_GOVERNANCE_URL, and a read that fails
# means NO intent is recorded (the bus retries the event) — a payload that could not be determined must not become
# a queued obligation somebody renders later. Consequence for an estate upgraded from N-M1a: intents recorded
# before this version carry no payload, and a REAL sender dead-letters them rather than inventing a body. Cancel
# them (`deliveryctl cancel <id>`) or leave them to dead-letter; either way an operator sees them.
#
# NOT in this step: the CI build sender and the rebuild loop (RC-3/RC-6). There is no ci_build or ci_rebuild
# delivery kind, no callback and no loop control — a kind nothing can send would read as a capability.

# Intelligence Gateway (cmd/intelligence) — the OPTIONAL AI plane (D13). Deploy this service
# ONLY when AI is enabled; when disabled, do not run it and set the consuming-context gate below.
# Disabled ≡ unavailable — the pipeline is correct with AI off. It owns no truth; with Δ3a it
# keeps ONE derived, rebuildable datastore (the Operational Semantic Index, see below).
THEMIS_INTELLIGENCE_ADDR=:8086             # HTTP listen address. Default :8086.
# THEMIS_GOVERNANCE_URL=...                # (shared, above) Governance read-API base URL — the AI Runtime's ONLY business read: the FindingAssessment Domain Projection (T10). It no longer reads Knowledge directly; Governance composes the enrichment into the projection, which is what stopped the runtime orchestrating across contexts.
# (no THEMIS_KNOWLEDGE_URL here — the Intelligence node does not read Knowledge at all. It grounds solely
#  from the Governance FindingAssessment projection (EDR-TRUST-01 T10). The knob was removed from
#  cmd/intelligence entirely rather than left ignored, so it cannot look load-bearing (TRUST-5).)
THEMIS_OLLAMA_URL=http://localhost:11434   # Ollama base URL (OpenAI-compatible). Mac dev: native Ollama (Metal GPU); cluster: the Ollama container Service.
THEMIS_INTELLIGENCE_MODEL=llama3.1:8b      # Pinned model. Default llama3.1:8b (16GB Apple Silicon-friendly).
# Router tiers (phase3-intelligence-router; both optional — a single-model deployment leaves them unset):
# THEMIS_INTELLIGENCE_MODEL_ESCALATION=      # a LARGER model: an honest `insufficient` on recommend_position
#                                            # retries ONCE here (G-AI-2b) — the bigger model may extract more
#                                            # from the same grounding; if it also declines, telemetry says so.
#                                            # Never fires on schema/business failures (contract problems) or
#                                            # timeouts. A value equal to the primary model is treated as unset.
# THEMIS_INTELLIGENCE_MODEL_ECONOMY=         # a SMALLER model: when the budget window is nearly spent, calls
#                                            # route here instead of refusing (G-AI-4 degrade-not-fail) — spend
#                                            # shrinks before it stops. Full exhaustion still answers
#                                            # budget_exhausted. Only meaningful with the budget enabled.
# THEMIS_INTELLIGENCE_BUDGET_DEGRADE_PCT=0.20  # degrade low-water mark, as a fraction (0,1) of the window ceiling.
THEMIS_INTELLIGENCE_PROVIDER=              # "fake" = deterministic dev/CI provider (no model); empty = ollama.
THEMIS_LLM_API_KEY=                        # optional bearer token for an authenticated OpenAI-compatible server (OpenAI, LM Studio "Require API Key", vLLM); empty = none (Ollama default).
THEMIS_LLM_RESPONSE_FORMAT=                # structured-output mode: empty = json_object (Ollama); "json_schema" (LM Studio / OpenAI); "text"; "none".
THEMIS_LLM_TIMEOUT=60s                     # Intelligence-side budget (Go duration, default 60s): BOTH the provider HTTP timeout and the Gateway's per-invocation deadline.
                                           # THREE deadlines govern one recommendation and the SHORTEST wins. Raising this alone is not enough — raise
                                           # THEMIS_INTELLIGENCE_TIMEOUT on the GOVERNANCE node to match, or Governance hangs up first and the Gateway
                                           # reports `provider_error` (surfacing as a 204 that reads like the model declining).

# Δ3a semantic precedent (RC-1) — the Operational Semantic Index (KS2). OPTIONAL: without a store
# DSN the Gateway is stateless and grounds recommend_position on exact-CVE precedent only. With it,
# recommend_position also retrieves semantically similar PAST Positions (a different CVE on the same
# component/bug-class). Needs THEMIS_BUS_DATABASE_DSN (shared, above) so the reader can populate it.
THEMIS_DATABASE_DSN=                       # Intelligence store DSN (its OWN `intelligence` DB). Empty = semantic precedent OFF. e.g. postgres://themis:themis@localhost:5432/intelligence?sslmode=disable
THEMIS_INTELLIGENCE_MIGRATE=0              # "1" applies the intelligence store migrations on startup.
# THEMIS_INTELLIGENCE_MIGRATIONS=internal/intelligence/adapters/store/migrations   # migrations dir (default shown).
THEMIS_INTELLIGENCE_EMBED_MODEL=nomic-embed-text  # embedding model via Ollama /v1/embeddings; ignored with the fake provider.
THEMIS_INTELLIGENCE_PRECEDENT_TOPK=5       # semantic precedents retrieved per recommendation. Default 5.

# D4 per-capability spend ceiling. BOTH must be > 0 to enforce anything; unset (the default) is
# UNLIMITED, which is deliberate: a budget switched on by accident refuses recommendations, and a
# refusal is indistinguishable downstream from the AI being unavailable (EDR-INTELLIGENCE-01 D13).
#
# The currency is tokens per fixed window, anchored to the first call rather than the wall clock —
# otherwise a node restarting at 13:59 would get a full budget twice in two minutes. Measured for
# scale: one grounded `recommend_position` on a real Finding costs ~1,800 tokens.
#
# Exhaustion is its own outcome (`X-Themis-AI-Reason: budget_exhausted`), never `insufficient`:
# nothing is broken, nothing declined on the merits, and it clears when the window rolls.
# THEMIS_INTELLIGENCE_BUDGET_TOKENS=200000
# THEMIS_INTELLIGENCE_MAX_RUN_TOKENS=8000    # G-AI-4 per-run ceiling: one invocation's total spend across retries + escalation; reaching it stops further attempts (budget_exhausted, guard:run-budget). Unset/0 = unlimited — the load-bearing default (a ceiling nobody set must never fire).
# THEMIS_INTELLIGENCE_LOG_RETENTION=720h   # Δ4a: how long the invocation log (the eval harness's capture) is kept before an age-based prune. Unset/0 = no pruning. The golden set promoted from it is DURABLE and never pruned. Only the Intelligence node with a store honors this.
# --- Δ4b autonomous plane (DEFAULT OFF) ---
# THEMIS_INTELLIGENCE_AUTO_BUDGET_TOKENS=500  # the autonomous pool ceiling per window. UNSET/0 = the autonomous sweep NEVER RUNS (the pool's existence is the enable switch; unset means OFF, not unlimited — nobody asked). A HARD isolation wall from the reactive budget: autonomy can never starve reactive triage.
# THEMIS_INTELLIGENCE_AUTO_BUDGET_WINDOW=24h # the pool's window (default 24h).
# THEMIS_INTELLIGENCE_AUTO_CADENCE=12h        # how often the cross-release-consistency analyst runs (default 12h). Only matters when the pool is set.
# --- AUTO-VOL-1 volume controls (contain the NOISE; the budget/guardrails contain the danger). Measured live: one seeded decision cascaded via semantic similarity to 110 advisory proposals in a SINGLE sweep. These gate what earns an advisory and cap how many one pass pushes. Unset ⇒ the code defaults below.
# THEMIS_INTELLIGENCE_AUTO_MIN_SCORE=0.75    # minimum cosine similarity a precedent must clear to be advised on (default 0.75). Below this the neighbour is "vaguely similar", not precedent. The exact-CVE fallback (same CVE, matched by lookup) is exempt.
# THEMIS_INTELLIGENCE_AUTO_MIN_OVERLAP=0.5   # minimum release-overlap (the G-AI-3 delta) a precedent must clear when overlap is known (default 0.5). A precedent from a barely-overlapping release does not qualify.
# THEMIS_INTELLIGENCE_AUTO_MAX_PER_PASS=20   # hard cap on advisory proposals pushed in ONE sweep, worst-first; the rest waits for the next window (default 20). Set < 0 to explicitly UNCAP (an operator who wants no cap).
# THEMIS_REGISTRY_URL=http://localhost:8082  # Registry read-API — the sweep enumerates releases through it.
# THEMIS_API_KEY=<write-scoped-key>          # the node's WRITE key for the autonomous push (POST /findings/{id}/proposals, proposer_kind: ai). Advisory only — Governance can NEVER auto-accept an ai proposal (constitutional, test-guarded).
# THEMIS_INTELLIGENCE_BUDGET_WINDOW=1h
THEMIS_INTELLIGENCE_REBUILD=0              # "1" purges the index + resets the bus cursor on boot, re-embedding every past Position (use ONCE after changing THEMIS_INTELLIGENCE_EMBED_MODEL).

# Disable gate (D13). The consuming context (Governance) wires the real vs a no-op Intelligence
# client from these — one switch, no call-site flags. Off = zero AI footprint.
# THEMIS_INTELLIGENCE_ENABLED=1            # global gate.
# THEMIS_GOVERNANCE_AI_ENABLED=0           # Governance-side gate: "1" wires the real client, else the no-op.
# THEMIS_INTELLIGENCE_URL=http://localhost:8086  # Governance → Intelligence reactive-API base URL (when enabled).
# THEMIS_INTELLIGENCE_TIMEOUT=60s          # how long Governance waits for a recommendation (Go duration, default 60s).
                                           # Set it >= THEMIS_LLM_TIMEOUT on the Intelligence node. The shorter deadline decides, and when this one
                                           # fires first Governance cancels the request — the Gateway then logs `provider_error` for what is really a
                                           # caller-side timeout, which is why a slow model looks like a broken one.

# --- Dashboard (EDR-GUI-01) --------------------------------------------------------------------
# The GUI node: static SPA + same-origin reverse proxy to the six read APIs. A VIEW, never a
# context — no database of its own, no truth; every number on screen is fetched live.
# THEMIS_DASHBOARD_ADDR=:8090               # listen address.
# THEMIS_REGISTRY_URL=http://localhost:8082      # the six proxied read-API bases (defaults match
# THEMIS_EVIDENCE_URL=http://localhost:8081      # the runbook ports — set only what differs).
# THEMIS_KNOWLEDGE_URL=http://localhost:8085
# THEMIS_GOVERNANCE_URL=http://localhost:8083
# THEMIS_COMMUNICATION_URL=http://localhost:8084
# THEMIS_INTELLIGENCE_URL=http://localhost:8086
# THEMIS_API_KEY=                           # the NODE key (D4): injected server-side as X-API-Key toward
#                                           # the nodes; it states "the dashboard may act", never who is
#                                           # asking — mint it ADMIN (write-capable), because the governed
#                                           # loop's accepts/publishes ride it; WHO may write is enforced
#                                           # per-operator at the dashboard's gate (D11). The browser never
#                                           # sees it.
# THEMIS_AUTH_DATABASE_DSN=                 # the browser-edge auth switch (D3): set => operators must sign
#                                           # in (paste their own API key once; a server-side session takes
#                                           # over) and the proxy enforces operator scope (D11: read keys
#                                           # cannot decide) + identity (D13) + write-time key re-check (D12).
#                                           # Unset => open edge (dev only) and the node logs AUTH DISABLED.
# THEMIS_AUTH_REQUIRED=0                    # "1" refuses to boot when the auth DSN is empty — the production
#                                           # guard: this node can never silently start open.
# THEMIS_DASHBOARD_USER=operator            # topbar identity when auth is OFF (ignored otherwise).
# THEMIS_DASHBOARD_ASSETS=                  # serve static assets from this dir instead of the embedded copy
#                                           # (design iteration only).
#
# TLS (D3, grilled 2026-08-13): the login paste is the one moment an operator's long-lived key
# transits the wire, and no cookie flag protects a paste. PRODUCTION DEPLOYMENTS FRONT THE
# DASHBOARD WITH TLS (any HTTPS-terminating reverse proxy; send X-Forwarded-Proto so the session
# cookie turns Secure). Plain HTTP inside a firewalled network is an acknowledged exception.
