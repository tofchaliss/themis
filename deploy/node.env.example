# Themis Phase-3 greenfield node — example environment configuration (CONVENTIONS.md R2).
#
# Every deployable node (evidence / registry / knowledge / governance / communication /
# intelligence) reads its configuration from the environment. Every option is documented
# here inline — there is no separate config reference that can drift. Copy this file, fill in
# the values for the node you are running, and export them (or load with your process
# manager). Secrets are referenced by name, never inlined.

# ─────────────────────────────────────────────────────────────────────────────
# Shared — observability (R1). Read identically by every node from the shared
# internal/platform/observability package. Console logging is always on; OpenTelemetry log
# export is enabled only when THEMIS_OTLP_LOGS_ENDPOINT is set.
# ─────────────────────────────────────────────────────────────────────────────

# Minimum log severity. One of: debug | info | warn | error. Default: info.
THEMIS_LOG_LEVEL=info

# Console log encoding. One of: json (machine-readable, prod) | console (human-readable, dev).
# Default: json.
THEMIS_LOG_FORMAT=json

# OTLP/HTTP logs collector endpoint, host:port (e.g. otel-collector:4318). When empty, OTel
# log export is OFF and only the console channel is active (nothing external needed to run).
# Default: "" (console-only).
THEMIS_OTLP_LOGS_ENDPOINT=

# Send to the OTLP endpoint over http instead of https ("1" to enable) — for local collectors.
# Default: 0 (https).
THEMIS_OTLP_INSECURE=0

# ─────────────────────────────────────────────────────────────────────────────
# Shared — datastore. Required by every node that persists.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL DSN. REQUIRED. Provide via your secret store, not a committed file.
THEMIS_DATABASE_DSN=postgres://themis:CHANGEME@localhost:5432/themis?sslmode=disable

# ─────────────────────────────────────────────────────────────────────────────
# Shared — inbound edge auth (F1, EDR-SECURITY-01). Read by every node that serves /api/v1.
# Guards EXTERNAL callers only; service-to-service read clients send no key (inbound-edge only).
# ─────────────────────────────────────────────────────────────────────────────

# DSN of the shared `auth` database (the api_keys store). When SET, this node requires a valid
# X-API-Key on /api/v1 (the node logs "AUTH ENABLED"); when EMPTY, auth is off (dev — logs
# "AUTH DISABLED"). Mint keys with `cmd/authadmin create-key --name <n> --scopes admin|read`
# (THEMIS_AUTH_MIGRATE=1 creates the table on first use; the token prints once). Default: "" (off).
THEMIS_AUTH_DATABASE_DSN=

# Production guard: "1" makes the node REFUSE TO START when THEMIS_AUTH_DATABASE_DSN is empty, so
# a node can never boot open by mistake. Leave 0 for single-box dev. Default: 0.
THEMIS_AUTH_REQUIRED=0

# ─────────────────────────────────────────────────────────────────────────────
# Per-node options (set the block for the node you are running). Each node's config struct
# in cmd/<node>/main.go documents these inline as well.
# ─────────────────────────────────────────────────────────────────────────────

# Evidence (cmd/evidence)
THEMIS_EVIDENCE_ADDR=:8081                 # HTTP listen address. Default :8081.
THEMIS_EVIDENCE_MIGRATE=0                  # "1" to apply Evidence migrations on startup.
THEMIS_EVIDENCE_DEV_PURGE=0                # "1" to expose DELETE /dev/evidence (dev only).
# THEMIS_EVIDENCE_KNOWN_RELEASES=          # dev only: comma-separated release ids for the stub SubjectRef; empty = registry-backed.

# Registry (cmd/registry)
THEMIS_REGISTRY_ADDR=:8082                 # HTTP listen address. Default :8082.
THEMIS_REGISTRY_MIGRATE=0                  # "1" to apply Registry migrations on startup.
THEMIS_REGISTRY_DEV_PURGE=0                # "1" to expose DELETE /dev/registry (dev only).

# Knowledge (cmd/knowledge)
THEMIS_KNOWLEDGE_ADDR=:8085                # HTTP listen address. Set :8085 (the code default :8082 collides with Registry).
THEMIS_KNOWLEDGE_MIGRATE=0                 # "1" to apply Knowledge migrations on startup.
THEMIS_EVIDENCE_URL=http://localhost:8081  # Evidence read-API base URL — the inventory source for correlation.
THEMIS_OSV_URL=https://api.osv.dev         # OSV query base URL — lazy discovery (language + distro ecosystems).
# Optional scheduled NVD modified-since watch (D5): enriches already-carded CVEs with authoritative CVSS/severity.
THEMIS_NVD_ENABLED=0                       # "1" to enable the watch. Default off (no external NVD calls).
# THEMIS_NVD_URL=                          # NVD 2.0 CVE API base URL. Empty = services.nvd.nist.gov.
# THEMIS_NVD_API_KEY=                      # NVD API key (higher rate limit; optional).
THEMIS_NVD_POLL_INTERVAL=6h                # Go duration between watch polls. Default 6h.
# Optional NVD correlation discovery (A2): a per-component, CPE-product-gated keyword query so a CVE only
# NVD's CPE data covers still yields a finding. Distinct from the watch above (this runs at correlation time).
THEMIS_NVD_DISCOVERY=0                      # "1" to enable. Default off. One NVD call per component — set THEMIS_NVD_API_KEY (NVD throttles hard without one).
# Optional scheduled exploit-signal enrichment (D5): folds EPSS/KEV/public-exploit onto already-carded CVEs.
THEMIS_EPSSKEV_ENABLED=0                   # "1" to enable the sweep. Default off (no external EPSS/KEV/ExploitDB calls).
# THEMIS_EPSS_URL=                         # FIRST.org EPSS gzip-CSV. Empty a source to skip it. Default = the current-scores feed.
# THEMIS_KEV_URL=                          # CISA KEV JSON catalog. Default = cisa.gov KEV feed.
# THEMIS_EXPLOITDB_URL=                     # ExploitDB files_exploits.csv. Default = the gitlab mirror.
THEMIS_EPSSKEV_POLL_INTERVAL=24h           # Go duration between enrichment sweeps. Default 24h.
# Optional Red Hat vendor feed (parity B3, EDR-VEX-01): per-CVE vendor severity + not_affected applicability
# folded onto already-carded CVEs — covers RHEL and its 1:1 rebuilds (Rocky, Alma). Relevance-bounded (D5).
THEMIS_REDHAT_ENABLED=0                     # "1" to enable the scheduled Red Hat sweep. Default off (no external Red Hat calls).
# THEMIS_REDHAT_URL=                        # Red Hat Security Data API base URL. Empty = the public Hydra default (access.redhat.com); no API key needed.
THEMIS_REDHAT_POLL_INTERVAL=12h            # Go duration between Red Hat sweeps. Default 12h.
# Optional generic CSAF-VEX vendor feed (parity B4, EDR-VEX-01): per-CVE not_affected applicability folded onto
# already-carded CVEs from any CSAF trusted provider. Relevance-bounded (D5) — fetches only carded CVEs, per-CVE.
THEMIS_VEXFEED_ENABLED=0                    # "1" to enable the scheduled CSAF-VEX sweep. Default off.
# THEMIS_VEXFEED_URLS=                      # Comma-separated CSAF-VEX directory base URLs (per-CVE files at <base>/<year>/cve-<id>.json). Empty = no feeds.
THEMIS_VEXFEED_POLL_INTERVAL=12h           # Go duration between CSAF-VEX sweeps. Default 12h.

# Governance (cmd/governance)
THEMIS_GOVERNANCE_ADDR=:8083               # HTTP listen address. Default :8083.
THEMIS_GOVERNANCE_MIGRATE=0                # "1" to apply Governance migrations on startup.
THEMIS_GOVERNANCE_DEV_PURGE=0              # "1" to expose DELETE /dev/governance (dev only).
THEMIS_REGISTRY_URL=http://localhost:8082  # Registry read-API base URL — the estate blast-radius source for the Finding priority multiplier (C2). Default :8082 (works on a single box); empty ⇒ multiplier defaults to 1.0×.
THEMIS_KNOWLEDGE_URL=http://localhost:8085 # Knowledge read-API base URL — the CVE-enrichment half of the FindingAssessment Domain Projection (EDR-TRUST-01 T10, GET /findings/{id}/assessment). Default :8085; empty ⇒ the projection carries the Finding alone (fail-safe: a Knowledge outage degrades the view, never the request).
THEMIS_BLAST_RADIUS_CAP=10                 # Unique-customer count at which the blast multiplier saturates to 2.0× (C2). Default 10 (legacy `intelligence.blast_radius_cap` parity). A value < 2 is treated as the default; the +0.1/customer slope means values above ~11 already saturate.
THEMIS_MITIGATED_WEIGHT=0.5                # Stance weight for `mitigated` in the posture's residual_priority (EDR-GOVERNANCE-01 D14). Must be in (0,1]; anything else falls back to 0.5. The other weights are STRUCTURAL and deliberately not configurable: not_affected/accepted_risk 0 (terminal — the risk is removed or knowingly owned), deferred 0.9, and affected/under_investigation/no-position 1.0. Note residual_priority is what you SORT a triage queue by; effective_priority stays the intrinsic severity so a suppression never erases how bad the issue actually is.

# Communication (cmd/communication)
THEMIS_COMMUNICATION_ADDR=:8084            # HTTP listen address. Default :8084.
THEMIS_GOVERNANCE_URL=http://localhost:8083 # Governance read-API base URL (for GetPosition).
THEMIS_COMMUNICATION_MIGRATE=0             # "1" to apply Communication migrations on startup.
THEMIS_COMMUNICATION_DEV_PURGE=0           # "1" to expose DELETE /dev/communication (dev only).

# Intelligence Gateway (cmd/intelligence) — the OPTIONAL AI plane (D13). Deploy this service
# ONLY when AI is enabled; when disabled, do not run it and set the consuming-context gate below.
# Disabled ≡ unavailable — the pipeline is correct with AI off. It owns no truth; with Δ3a it
# keeps ONE derived, rebuildable datastore (the Operational Semantic Index, see below).
THEMIS_INTELLIGENCE_ADDR=:8086             # HTTP listen address. Default :8086.
# THEMIS_GOVERNANCE_URL=...                # (shared, above) Governance read-API base URL — the AI Runtime's ONLY business read: the FindingAssessment Domain Projection (T10). It no longer reads Knowledge directly; Governance composes the enrichment into the projection, which is what stopped the runtime orchestrating across contexts.
# (no THEMIS_KNOWLEDGE_URL here — the Intelligence node does not read Knowledge at all. It grounds solely
#  from the Governance FindingAssessment projection (EDR-TRUST-01 T10). The knob was removed from
#  cmd/intelligence entirely rather than left ignored, so it cannot look load-bearing (TRUST-5).)
THEMIS_OLLAMA_URL=http://localhost:11434   # Ollama base URL (OpenAI-compatible). Mac dev: native Ollama (Metal GPU); cluster: the Ollama container Service.
THEMIS_INTELLIGENCE_MODEL=llama3.1:8b      # Pinned model. Default llama3.1:8b (16GB Apple Silicon-friendly).
THEMIS_INTELLIGENCE_PROVIDER=              # "fake" = deterministic dev/CI provider (no model); empty = ollama.
THEMIS_LLM_API_KEY=                        # optional bearer token for an authenticated OpenAI-compatible server (OpenAI, LM Studio "Require API Key", vLLM); empty = none (Ollama default).
THEMIS_LLM_RESPONSE_FORMAT=                # structured-output mode: empty = json_object (Ollama); "json_schema" (LM Studio / OpenAI); "text"; "none".
THEMIS_LLM_TIMEOUT=60s                     # provider HTTP timeout (Go duration). Default 60s. Raise for a slower/larger local model whose grounded recommend exceeds 60s (else the call returns an "insufficient" 204).

# Δ3a semantic precedent (RC-1) — the Operational Semantic Index (KS2). OPTIONAL: without a store
# DSN the Gateway is stateless and grounds recommend_position on exact-CVE precedent only. With it,
# recommend_position also retrieves semantically similar PAST Positions (a different CVE on the same
# component/bug-class). Needs THEMIS_BUS_DATABASE_DSN (shared, above) so the reader can populate it.
THEMIS_DATABASE_DSN=                       # Intelligence store DSN (its OWN `intelligence` DB). Empty = semantic precedent OFF. e.g. postgres://themis:themis@localhost:5432/intelligence?sslmode=disable
THEMIS_INTELLIGENCE_MIGRATE=0              # "1" applies the intelligence store migrations on startup.
# THEMIS_INTELLIGENCE_MIGRATIONS=internal/intelligence/adapters/store/migrations   # migrations dir (default shown).
THEMIS_INTELLIGENCE_EMBED_MODEL=nomic-embed-text  # embedding model via Ollama /v1/embeddings; ignored with the fake provider.
THEMIS_INTELLIGENCE_PRECEDENT_TOPK=5       # semantic precedents retrieved per recommendation. Default 5.
THEMIS_INTELLIGENCE_REBUILD=0              # "1" purges the index + resets the bus cursor on boot, re-embedding every past Position (use ONCE after changing THEMIS_INTELLIGENCE_EMBED_MODEL).

# Disable gate (D13). The consuming context (Governance) wires the real vs a no-op Intelligence
# client from these — one switch, no call-site flags. Off = zero AI footprint.
# THEMIS_INTELLIGENCE_ENABLED=1            # global gate.
# THEMIS_GOVERNANCE_AI_ENABLED=0           # Governance-side gate: "1" wires the real client, else the no-op.
# THEMIS_INTELLIGENCE_URL=http://localhost:8086  # Governance → Intelligence reactive-API base URL (when enabled).
