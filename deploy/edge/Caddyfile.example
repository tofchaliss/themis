# Themis network edge (VM-NET-1, EDR-GUI-01 D3): TLS in front of the dashboard, and the two API
# routes a build system needs, on 443 and nothing else.
#
# Every node listens on loopback (INSTALLATION.md §7a step 1). Caddy terminates HTTPS and
# publishes exactly three things: the dashboard (default), Evidence's intake under /evidence/
# (a CI job uploads the new SBOM there with its product-scoped key), and Communication under
# /communication/ (the CI job's callback, delivery:callback key). handle_path strips the prefix,
# so the nodes see their own /api/v1/... paths. Governance, Knowledge, Registry and Intelligence
# are NOT published: scripts run on the host, and a remote caller for one of them is the moment
# to add a block here, deliberately. reverse_proxy adds X-Forwarded-Proto, so the dashboard's
# session cookie turns Secure.
#
# Install: copy to /etc/caddy/Caddyfile and replace the hostname with the VM's own
# (`hostname -f`). `tls internal` issues a certificate from Caddy's local CA — browsers and the
# CI host must trust that CA (`caddy trust` on the VM, or import
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt), or replace the line with
# `tls /etc/ssl/certs/themis.crt /etc/ssl/private/themis.key` for a company certificate. For a
# public name, delete the line and Caddy obtains one from Let's Encrypt.

themis.example.internal {
	tls internal
	encode gzip
	handle_path /evidence/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle_path /communication/* {
		reverse_proxy 127.0.0.1:8084
	}
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}
