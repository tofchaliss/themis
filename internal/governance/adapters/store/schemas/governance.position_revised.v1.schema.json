{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis-project.dev/schemas/governance/governance.position_revised.v1.schema.json",
  "title": "governance.position_revised.v1",
  "description": "Integration-contract v1 for the PositionRevised event payload (M5 EB-03; current wire shape frozen). Same thin shape as PositionEstablished; the other Position event Communication consumes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["FindingID", "ReleaseID", "FaultlineID", "CVE", "Version", "Stance", "OccurredAt"],
  "properties": {
    "FindingID": { "type": "string" },
    "ReleaseID": { "type": "string" },
    "FaultlineID": { "type": "string" },
    "CVE": { "type": "string" },
    "Version": { "type": "integer" },
    "Stance": { "type": "string" },
    "OccurredAt": { "type": "string", "format": "date-time" }
  }
}
