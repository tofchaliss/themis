{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis-project.dev/schemas/governance/governance.position_established.v1.schema.json",
  "title": "governance.position_established.v1",
  "description": "Integration-contract v1 for the PositionEstablished event payload (M5 EB-03; current wire shape frozen). One of the two Position events Communication consumes.",
  "type": "object",
